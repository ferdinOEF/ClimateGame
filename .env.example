# Riptide Rising — Firebase web config.
#
# Copy to `.env.local` and fill in from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
#
# THE GAME RUNS WITHOUT THIS FILE. With no config, the campaign, levels,
# stars, badges and personal bests all work against localStorage; only the
# shared leaderboard and cross-device sync are unavailable. Leave it unset
# for local development if you don't want a Firebase project of your own.
#
# These values are NOT secrets. A Firebase web config identifies the
# project and ships in the client bundle of every Firebase web app by
# design. What protects the data is firestore.rules plus API-key referrer
# restrictions — see docs/DEPLOY.md. Do not commit your real .env.local
# anyway: it makes it far too easy to point a dev build at production.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point Auth and Firestore at local emulators instead of
# the real project (`npm run emulators` in another terminal). Keeps test
# data out of your production quota. `npm run dev:emulated` uses the
# `.env.emulated` mode file if you'd rather keep the two separate.
VITE_FIREBASE_EMULATORS=false

# Set to "true" to ask players for an email address before their first level
# and to show the sign-in / account features. Off (empty or anything else) by
# default: players go straight into the game and no email is collected. Read
# at build time, so changing it needs a rebuild. See docs/DEPLOY.md.
VITE_REQUIRE_EMAIL=false
